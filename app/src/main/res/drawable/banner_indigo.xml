<?xml version="1.0" encoding="utf-8"?>
<!-- 学習用に自作したバナー画像（ベクター画像）。外部の素材は使っていない。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="160dp"
    android:viewportWidth="360"
    android:viewportHeight="160">

    <path android:pathData="M0,0h360v160h-360z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="160"
                android:endX="360"
                android:endY="0">
                <item android:offset="0" android:color="#FF3730A3" />
                <item android:offset="1" android:color="#FFA78BFA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 飾りの斜めの帯（白の半透明） -->
    <path
        android:fillColor="#1CFFFFFF"
        android:pathData="M200,0L260,0L160,160L100,160z" />
    <path
        android:fillColor="#14FFFFFF"
        android:pathData="M290,0L340,0L240,160L190,160z" />
    <path
        android:fillColor="#26FFFFFF"
        android:pathData="M300,40a18,18 0 1,0 36,0a18,18 0 1,0 -36,0" />
</vector>
